package templates

import (
	"github.com/habibmuhammad/deploymate/internal/gitpkg"
	"github.com/habibmuhammad/deploymate/internal/store"
)

// DeployPreview is what a git deploy would ship, vs the deployed commit.
type DeployPreview struct {
	Range       gitpkg.Range
	DeployedSHA string
	CommitURL   string // web URL of the head commit, "" when unguessable
	FirstDeploy bool
	NothingToDo bool
	Prebuilt    bool // artifact-mode app: the button deploys the latest successful CI run
}

templ DeployPreviewPage(vc ViewCtx, project store.Project, app store.App, p DeployPreview) {
	@Layout(vc, "Review deploy · "+app.Name, app.Slug, []Crumb{
		{Label: project.Name, Href: "/projects/" + project.Slug},
		{Label: app.Name, Href: "/apps/" + app.Slug},
		{Label: "Review deploy"},
	}) {
		<div class="page-head">
			<div>
				<h1>Review before deploying</h1>
				<p class="muted-text">
					{ app.Name } ·
					if p.FirstDeploy {
						first deploy — nothing has shipped yet.
					} else {
						running <span class="mono">{ shortSHA8(p.DeployedSHA) }</span> now.
					}
				</p>
			</div>
			<div class="app-actions">
				<a class="btn btn-ghost" href={ templ.SafeURL("/apps/" + app.Slug) }>Cancel</a>
				if !p.NothingToDo {
					<form method="post" action={ "/apps/" + app.Slug + "/git/deploy" }>
						<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
						<input type="hidden" name="sha" value={ p.Range.Head }/>
						if p.Prebuilt {
							<button class="btn btn-primary" type="submit">Deploy latest successful run</button>
						} else {
							<button class="btn btn-primary" type="submit">Deploy { shortSHA8(p.Range.Head) }</button>
						}
					</form>
				}
			</div>
		</div>

		if p.NothingToDo {
			<div class="empty"><p>Nothing new to deploy.</p><p>The branch head is the commit that is already running.</p></div>
		} else {
			<div class="stat-strip">
				<div class="stat-card">
					<div class="stat-value">{ len(p.Range.Commits) }</div>
					<div class="stat-label">Commits</div>
				</div>
				<div class="stat-card">
					<div class="stat-value">{ p.Range.Files }</div>
					<div class="stat-label">Files changed</div>
				</div>
				<div class="stat-card">
					<div class="stat-value">+{ p.Range.Added }</div>
					<div class="stat-label">Lines added</div>
				</div>
				<div class="stat-card">
					<div class="stat-value">−{ p.Range.Deleted }</div>
					<div class="stat-label">Lines removed</div>
				</div>
			</div>

			<div class="panel">
				<div class="panel-title">What will ship</div>
				if len(p.Range.Commits) == 0 {
					<p class="muted-text">No commits found.</p>
				} else {
					<table class="deploy-table">
						<thead>
							<tr>
								<th>Commit</th>
								<th>Subject</th>
								<th>Author</th>
								<th>Date</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range p.Range.Commits {
								<tr>
									<td class="mono">
										if p.CommitURL != "" {
											<a class="deploy-link" href={ p.CommitURL } target="_blank" rel="noopener" title={ p.CommitURL }>{ c.Short } ↗</a>
										} else {
											{c.Short}
										}
									</td>
									<td>{ c.Subject }</td>
									<td class="muted-text">{ c.Author }</td>
									<td class="muted-text">{ c.Date }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>

			<p class="muted-text panel-hint">Deploying pins commit <span class="mono">{ shortSHA8(p.Range.Head) }</span>, exactly what is listed above.</p>
		}
	}
}

templ DeployPreviewError(vc ViewCtx, project store.Project, app store.App, message string) {
	@Layout(vc, "Review deploy · "+app.Name, app.Slug, []Crumb{
		{Label: project.Name, Href: "/projects/" + project.Slug},
		{Label: app.Name, Href: "/apps/" + app.Slug},
		{Label: "Review deploy"},
	}) {
		<div class="page-head">
			<div>
				<h1>Review before deploying</h1>
				<p class="muted-text">{ app.Name }</p>
			</div>
			<div class="app-actions">
				<a class="btn btn-ghost" href={ templ.SafeURL("/apps/" + app.Slug) }>Back to app</a>
			</div>
		</div>
		<div class="flash flash-error">{ message }</div>
	}
}

// shortSHA8 shortens a full sha for display.
func shortSHA8(sha string) string {
	if len(sha) > 8 {
		return sha[:8]
	}
	return sha
}
