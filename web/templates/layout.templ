package templates

import "strings"

// AssetVersion is appended to the stylesheet and script URLs (?v=…), so a new release is never served from a
// browser or CDN copy of the old files. The server sets it once at start.
var AssetVersion = "0"

func assetURL(path string) string { return path + "?v=" + AssetVersion }

// ViewCtx carries the per-request values every page needs.
type ViewCtx struct {
	Email string
	CSRF  string
	Flash string
	Path  string // the request path, to mark the current item in the sidebar
}

// navCurrent is the sidebar item a path belongs to: the most specific prefix, Projects for everything else
// (apps, services, deployments and history all live under a project).
func navCurrent(path string) string {
	for _, href := range []string{"/server", "/nodes", "/security", "/signins", "/stats", "/settings/github", "/settings/tokens", "/alerts"} {
		if path == href || strings.HasPrefix(path, href+"/") {
			return href
		}
	}
	return "/projects"
}

// Crumb is one breadcrumb step. Href "" renders the step as the current
// page (not a link).
type Crumb struct {
	Label string
	Href  string
}

templ Layout(vc ViewCtx, title string, appSlug string, crumbs []Crumb) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · DeployMate</title>
			<script>
				// Apply the saved theme before first paint (dark is the default).
				try { var t = localStorage.getItem("dm-theme"); if (t === "light") document.documentElement.setAttribute("data-theme", "light"); if (localStorage.getItem("dm-nav") === "rail") document.documentElement.setAttribute("data-nav", "rail"); } catch (e) {}
			</script>
			<link rel="stylesheet" href={ assetURL("/static/app.css") }/>
			<script src={ assetURL("/static/htmx.min.js") } defer></script>
			<script src={ assetURL("/static/chart.umd.min.js") } defer></script>
			<script src={ assetURL("/static/app.js") } defer></script>
		</head>
		<body
			if appSlug != "" {
				data-app-slug={ appSlug }
			}
		>
			<header class="mobilebar">
				<button class="navbtn" type="button" data-nav-open aria-label="Open menu" aria-controls="sidenav">
					@navIcon("menu")
				</button>
				<a class="brand" href="/projects">
					<span class="led"></span>
					<span>deploymate</span>
				</a>
			</header>
			<div class="navscrim" data-nav-close></div>
			<div class="shell">
				<nav class="sidenav" id="sidenav" aria-label="Main">
					<a class="brand" href="/projects" title="deploymate">
						<span class="led"></span>
						<span class="nav-label">deploymate</span>
					</a>
					@sideLink(vc.Path, "/projects", "Projects", "projects")
					<div class="navsec">Server</div>
					@sideLink(vc.Path, "/server", "Health", "server")
					@sideLink(vc.Path, "/nodes", "Nodes", "nodes")
					@sideLink(vc.Path, "/security", "Security", "shield")
					@sideLink(vc.Path, "/signins", "Sign-ins", "signin")
					@sideLink(vc.Path, "/stats", "Build stats", "stats")
					<div class="navsec">Settings</div>
					@sideLink(vc.Path, "/settings/github", "GitHub", "github")
					@sideLink(vc.Path, "/settings/tokens", "API tokens", "key")
					@sideLink(vc.Path, "/alerts", "Alerts", "bell")
					<div class="navgrow"></div>
					<button class="navlink theme-toggle" type="button" data-theme-toggle title="Switch theme" aria-label="Switch between dark and light theme">
						@navIcon("moon")
						@navIcon("sun")
						<span class="nav-label">Theme</span>
					</button>
					<button class="navlink navcollapse" type="button" data-nav-collapse title="Collapse menu" aria-label="Collapse or expand the menu">
						@navIcon("collapse")
						<span class="nav-label">Collapse</span>
					</button>
					<form class="navuser" method="post" action="/logout">
						<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
						<span class="nav-label user-chip" title={ vc.Email }>{ vc.Email }</span>
						<button class="navlink navlogout" type="submit" title="Log out" aria-label="Log out">
							@navIcon("logout")
						</button>
					</form>
				</nav>
				<div class="maincol">
			<main class="container">
				<nav class="crumbs" aria-label="Breadcrumb">
					if len(crumbs) == 0 {
						<span class="crumb-here">Projects</span>
					} else {
						<a class="crumb-link" href="/projects">Projects</a>
						for _, c := range crumbs {
							<span class="crumb-sep" aria-hidden="true">/</span>
							if c.Href != "" {
								<a class="crumb-link" href={ c.Href }>{ c.Label }</a>
							} else {
								<span class="crumb-here">{ c.Label }</span>
							}
						}
					}
				</nav>
				if vc.Flash != "" {
					<div class="flash">{ vc.Flash }</div>
				}
				{ children... }
			</main>
				</div>
			</div>
		</body>
	</html>
}

templ sideLink(path, href, label, icon string) {
	<a
		class={ "navlink", templ.KV("on", navCurrent(path) == href) }
		href={ templ.SafeURL(href) }
		title={ label }
		if navCurrent(path) == href {
			aria-current="page"
		}
	>
		@navIcon(icon)
		<span class="nav-label">{ label }</span>
	</a>
}

templ navIcon(name string) {
	<svg class={ "navicon", "icon-" + name } viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "projects":
				<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>
			case "server":
				<rect x="3" y="4" width="18" height="6" rx="1.5"/>
				<rect x="3" y="14" width="18" height="6" rx="1.5"/>
				<path d="M7 7h.01M7 17h.01"/>
			case "nodes":
				<circle cx="12" cy="5" r="2.5"/>
				<circle cx="5" cy="19" r="2.5"/>
				<circle cx="19" cy="19" r="2.5"/>
				<path d="M12 7.5v4M12 11.5l-5.5 5.5M12 11.5l5.5 5.5"/>
			case "shield":
				<path d="M12 3l8 3v6c0 4.5-3.2 8.2-8 9-4.8-.8-8-4.5-8-9V6l8-3z"/>
				<path d="m9 12 2 2 4-4"/>
			case "signin":
				<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
				<path d="m10 17 5-5-5-5M15 12H3"/>
			case "stats":
				<path d="M18 20V10"/>
				<path d="M12 20V4"/>
				<path d="M6 20v-6"/>
			case "github":
				<circle cx="6" cy="6" r="2.5"/>
				<circle cx="6" cy="18" r="2.5"/>
				<circle cx="18" cy="8" r="2.5"/>
				<path d="M6 8.5v7M18 10.5c0 4-6 3-11.5 5.5"/>
			case "key":
				<circle cx="7.5" cy="15.5" r="4.5"/>
				<path d="M10.7 12.3 21 2"/>
				<path d="m18 5 3 3"/>
				<path d="m15 8 2 2"/>
			case "bell":
				<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
				<path d="M13.73 21a2 2 0 0 1-3.46 0"/>
			case "moon":
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
			case "sun":
				<circle cx="12" cy="12" r="4"/>
				<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
			case "collapse":
				<path d="m11 7-5 5 5 5M18 7l-5 5 5 5"/>
			case "menu":
				<path d="M4 6h16M4 12h16M4 18h16"/>
			case "logout":
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
		}
	</svg>
}
