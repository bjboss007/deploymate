package templates

// ViewCtx carries the per-request values every page needs.
type ViewCtx struct {
	Email string
	CSRF  string
	Flash string
}

// Crumb is one breadcrumb step. Href "" renders the step as the current
// page (not a link).
type Crumb struct {
	Label string
	Href  string
}

templ Layout(vc ViewCtx, title string, appSlug string, crumbs []Crumb) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · DeployMate</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/chart.umd.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body
			if appSlug != "" {
				data-app-slug={ appSlug }
			}
		>
			<header class="topbar">
				<a class="brand" href="/projects">
					<span class="led"></span>
					<span>deploymate</span>
				</a>
				<div class="topbar-right">
					<a class="topbar-link" href="/alerts" title="Alerts" aria-label="Alerts">
						<svg class="topbar-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
							<path d="M13.73 21a2 2 0 0 1-3.46 0"/>
						</svg>
					</a>
					<span class="user-chip">{ vc.Email }</span>
					<form method="post" action="/logout">
						<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
						<button class="btn btn-ghost" type="submit">Log out</button>
					</form>
				</div>
			</header>
			<main class="container">
				<nav class="crumbs" aria-label="Breadcrumb">
					if len(crumbs) == 0 {
						<span class="crumb-here">Projects</span>
					} else {
						<a class="crumb-link" href="/projects">Projects</a>
						for _, c := range crumbs {
							<span class="crumb-sep" aria-hidden="true">/</span>
							if c.Href != "" {
								<a class="crumb-link" href={ c.Href }>{ c.Label }</a>
							} else {
								<span class="crumb-here">{ c.Label }</span>
							}
						}
					}
				</nav>
				if vc.Flash != "" {
					<div class="flash">{ vc.Flash }</div>
				}
				{ children... }
			</main>
		</body>
	</html>
}
