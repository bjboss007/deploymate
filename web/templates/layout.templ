package templates

// ViewCtx carries the per-request values every page needs.
type ViewCtx struct {
	Email string
	CSRF  string
	Flash string
}

// Crumb is one breadcrumb step. Href "" renders the step as the current
// page (not a link).
type Crumb struct {
	Label string
	Href  string
}

templ Layout(vc ViewCtx, title string, appSlug string, crumbs []Crumb) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · DeployMate</title>
			<script>
				// Apply the saved theme before first paint (dark is the default).
				try { var t = localStorage.getItem("dm-theme"); if (t === "light") document.documentElement.setAttribute("data-theme", "light"); } catch (e) {}
			</script>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/chart.umd.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body
			if appSlug != "" {
				data-app-slug={ appSlug }
			}
		>
			<header class="topbar">
				<a class="brand" href="/projects">
					<span class="led"></span>
					<span>deploymate</span>
				</a>
				<div class="topbar-right">
					<a class="topbar-link" href="/settings/github" title="GitHub connection" aria-label="GitHub connection">
						<svg class="topbar-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="6" cy="6" r="2.5"/>
							<circle cx="6" cy="18" r="2.5"/>
							<circle cx="18" cy="8" r="2.5"/>
							<path d="M6 8.5v7M18 10.5c0 4-6 3-11.5 5.5"/>
						</svg>
					</a>
					<a class="topbar-link" href="/server" title="Server health" aria-label="Server health">
						<svg class="topbar-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="3" y="4" width="18" height="6" rx="1.5"/>
							<rect x="3" y="14" width="18" height="6" rx="1.5"/>
							<path d="M7 7h.01M7 17h.01"/>
						</svg>
					</a>
					<a class="topbar-link" href="/stats" title="Build statistics" aria-label="Build statistics">
						<svg class="topbar-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M18 20V10"/>
							<path d="M12 20V4"/>
							<path d="M6 20v-6"/>
						</svg>
					</a>
					<a class="topbar-link" href="/alerts" title="Alerts" aria-label="Alerts">
						<svg class="topbar-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
							<path d="M13.73 21a2 2 0 0 1-3.46 0"/>
						</svg>
					</a>
					<a class="topbar-link" href="/settings/tokens" title="API tokens" aria-label="API tokens">
						<svg class="topbar-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="7.5" cy="15.5" r="4.5"/>
							<path d="M10.7 12.3 21 2"/>
							<path d="m18 5 3 3"/>
							<path d="m15 8 2 2"/>
						</svg>
					</a>
					<button class="topbar-link theme-toggle" type="button" data-theme-toggle title="Switch theme" aria-label="Switch between dark and light theme">
						<svg class="topbar-icon icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
						<svg class="topbar-icon icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
					</button>
					<span class="user-chip">{ vc.Email }</span>
					<form method="post" action="/logout">
						<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
						<button class="btn btn-ghost" type="submit">Log out</button>
					</form>
				</div>
			</header>
			<main class="container">
				<nav class="crumbs" aria-label="Breadcrumb">
					if len(crumbs) == 0 {
						<span class="crumb-here">Projects</span>
					} else {
						<a class="crumb-link" href="/projects">Projects</a>
						for _, c := range crumbs {
							<span class="crumb-sep" aria-hidden="true">/</span>
							if c.Href != "" {
								<a class="crumb-link" href={ c.Href }>{ c.Label }</a>
							} else {
								<span class="crumb-here">{ c.Label }</span>
							}
						}
					}
				</nav>
				if vc.Flash != "" {
					<div class="flash">{ vc.Flash }</div>
				}
				{ children... }
			</main>
		</body>
	</html>
}
