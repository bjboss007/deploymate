package templates

import "github.com/habibmuhammad/deploymate/internal/store"

// HistoryStats is the derived-intelligence strip for the history page.
type HistoryStats struct {
	Deploys       int
	SuccessRate   float64
	AvgBuildSec   float64
	UptimePct     float64
	UptimeSamples int
	MTTRMin       float64
	Incidents     int
}

// HistoryItem is one merged timeline entry (deployment or event).
type HistoryItem struct {
	TS    string
	Kind  string
	Label string
	Data  string
	Tone  string // good | bad | neutral
	// Category drives the page's filters: deploy | health | lifecycle | config.
	Category string
	Href     string // deployments link to their page
	Ref      string // short deployment id
	Clock    string // local "15:04", set when grouped by day
}

// HistoryDay is one calendar day of the timeline.
type HistoryDay struct {
	Label string
	Items []HistoryItem
}

templ HistoryPage(vc ViewCtx, project store.Project, app store.App, stats HistoryStats, days []HistoryDay) {
	@Layout(vc, "History · "+app.Name, "", []Crumb{
		{Label: project.Name, Href: "/projects/" + project.Slug},
		{Label: app.Name, Href: "/apps/" + app.Slug},
		{Label: "History"},
	}) {
		<div class="page-head">
			<div>
				<h1>{ app.Name } — history</h1>
				<p class="muted-text">Everything DeployMate has recorded for this app in the last 30 days.</p>
			</div>
			<div class="head-actions">
				<a class="btn btn-ghost" href={ "/apps/" + app.Slug }>Back to app</a>
			</div>
		</div>

		<div class="stat-strip">
			<div class="stat-card">
				<div class="stat-value">{ stats.Deploys }</div>
				<div class="stat-label">Deploys in 30 days</div>
			</div>
			<div class="stat-card">
				if stats.Deploys > 0 {
					<div class="stat-value">{ fmtPct(stats.SuccessRate) }</div>
				} else {
					<div class="stat-value muted-text">—</div>
				}
				<div class="stat-label">Succeeded</div>
			</div>
			<div class="stat-card">
				<div class="stat-value">{ fmtSec(stats.AvgBuildSec) }</div>
				<div class="stat-label">Average build</div>
			</div>
			<div class="stat-card">
				if stats.UptimeSamples > 0 {
					<div class="stat-value">{ fmtPct(stats.UptimePct) }</div>
				} else {
					<div class="stat-value muted-text">—</div>
				}
				<div class="stat-label">
					if stats.UptimeSamples > 0 {
						Uptime · { stats.UptimeSamples } checks
					} else {
						Uptime · add a domain to measure it
					}
				</div>
			</div>
			<div class="stat-card">
				if stats.Incidents > 0 {
					<div class="stat-value">{ fmtMin(stats.MTTRMin) }</div>
				} else {
					<div class="stat-value muted-text">—</div>
				}
				<div class="stat-label">Time to recover · { stats.Incidents } incidents</div>
			</div>
		</div>

		<div class="panel">
			<div class="panel-title">Timeline
				<span class="log-tools" data-history-filters>
					<button class="chip is-on" type="button" data-hf="">All</button>
					<button class="chip" type="button" data-hf="deploy">Deploys</button>
					<button class="chip" type="button" data-hf="health">Health</button>
					<button class="chip" type="button" data-hf="lifecycle">Start &amp; stop</button>
					<button class="chip" type="button" data-hf="config">Changes</button>
				</span>
			</div>
			if len(days) == 0 {
				<p class="muted-text">Nothing recorded yet. Deploy the app and its history starts here.</p>
			} else {
				<div class="timeline" data-history>
					for _, day := range days {
						<div class="day-head">{ day.Label }</div>
						for _, it := range day.Items {
							<div class="timeline-row" data-cat={ it.Category }>
								<span class={ "timeline-dot", "tone-" + it.Tone } aria-hidden="true"></span>
								<div class="timeline-body">
									<div class="timeline-head">
										<span class="timeline-kind">
											if it.Href != "" {
												<a class="deploy-link" href={ templ.SafeURL(it.Href) }>{ it.Label }</a>
												<span class="mono muted-text">{ it.Ref }</span>
											} else {
												{ it.Label }
											}
										</span>
										<span class="mono muted-text timeline-ts" title={ shortTime(it.TS) }>{ it.Clock }</span>
									</div>
									if it.Data != "" {
										<div class="timeline-data">{ clip(it.Data, 300) }</div>
									}
								</div>
							</div>
						}
					}
				</div>
			}
		</div>
	}
}
