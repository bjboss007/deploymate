package templates

import "github.com/habibmuhammad/deploymate/internal/store"

templ DeploymentPage(vc ViewCtx, project store.Project, app store.App, d store.Deployment) {
	@Layout(vc, "Deploy "+app.Name, "", []Crumb{
		{Label: project.Name, Href: "/projects/" + project.Slug},
		{Label: app.Name, Href: "/apps/" + app.Slug},
		{Label: shortDeployID(d.ID)},
	}) {
		<div class="page-head">
			<div>
				<h1>Deployment</h1>
				<p class="muted">
					if d.CommitSHA != "" {
						<span class="mono">{ d.CommitSHA }</span>
						if d.CommitMessage != "" {
							<span> — { d.CommitMessage }</span>
						}
					} else {
						<span>manual deploy</span>
					}
				</p>
			</div>
			<div class="head-actions">
				@statusBadge(d.Status)
			</div>
		</div>

		if d.Error != "" {
			<div class="flash flash-error">{ d.Error }</div>
		}

		<div class="panel">
			<div class="panel-title">Build &amp; deploy log</div>
			<div id="logs" class="log-panel" data-log-src={ "/deployments/" + d.ID + "/stream" }>
				<span class="log-wait">connecting — history replays automatically…</span>
			</div>
		</div>
	}
}
