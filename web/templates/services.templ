package templates

import "github.com/habibmuhammad/deploymate/internal/store"

// BackupView carries a service's backup config + catalog to the page. The
// objects are a page-local copy — the destination listing is the catalog,
// so rows are re-listed on every page load.
type BackupView struct {
	Enabled     bool
	Schedule    string
	Keep        int
	Destination string
	HasDests    bool
	DestIDs     []string
	Objects     []BackupObject
}

// BackupObject is one stored backup row on the service page.
type BackupObject struct {
	Key     string // object key — the restore form's handle on the object
	TakenAt string // RFC3339
	Size    int64
	SHA     string // hex sha256 of the encrypted blob ("" if meta unreadable)
}

// ServicePage is the service's front panel: state, a spec plate, the
// connection readout the service exists to hand out, and — for postgres —
// the backups section.
templ ServicePage(vc ViewCtx, project store.Project, sv store.Service, typeLabel, urlEnvKey, connURL string, bk BackupView, users []store.App) {
	@Layout(vc, sv.Name, "", []Crumb{{Label: project.Name, Href: "/projects/" + project.Slug}, {Label: sv.Name}}) {
		<div class="page-head">
			<div>
				<h1>{ sv.Name }</h1>
				<div class="svc-meta">
					@statusBadge(sv.Status)
					@envBadge(sv.Environment)
					if sv.Orphaned {
						<span class="badge badge-failed">orphaned</span>
					}
				</div>
			</div>
			<div class="head-actions">
				if sv.Status == "running" {
					<form method="post" action={ "/services/" + sv.Slug + "/stop" }>
						<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
						<button class="btn btn-ghost" type="submit">Stop</button>
					</form>
					<form method="post" action={ "/services/" + sv.Slug + "/restart" }>
						<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
						<button class="btn btn-ghost" type="submit">Restart</button>
					</form>
				} else {
					<form method="post" action={ "/services/" + sv.Slug + "/start" }>
						<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
						<button class="btn btn-primary" type="submit">Start</button>
					</form>
				}
				if sv.Orphaned {
					<form method="post" action={ "/services/" + sv.Slug + "/keep" }>
						<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
						<button class="btn btn-ghost" type="submit">Keep</button>
					</form>
				}
			</div>
		</div>

		if sv.Orphaned {
			<div class="panel panel-warn">
				<div class="panel-title">Orphaned — no longer in the manifest</div>
				<p class="muted">A deploy created this { sv.Type } service from deploymate.yml, but the manifest no longer declares it for the { sv.Environment } environment. DeployMate never deletes infrastructure on its own. Keep claims it as manually managed; Delete removes the container and row — its data volume is kept.</p>
			</div>
		}

		// The spec plate: the appliance's engraved identity.
		<div class="svc-plate">
			<div class="svc-cell">
				<span class="svc-key">Type</span>
				<span class="svc-val">{ typeLabel }</span>
			</div>
			<div class="svc-cell">
				<span class="svc-key">Image</span>
				<span class="svc-val">{ sv.Image }</span>
			</div>
			<div class="svc-cell">
				<span class="svc-key">Internal port</span>
				<span class="svc-val">:{ sv.Port }</span>
			</div>
			<div class="svc-cell">
				<span class="svc-key">Data volume</span>
				<span class="svc-val">{ sv.VolumeName }</span>
			</div>
		</div>

		if connURL != "" {
			// The readout: the one string this page hands out.
			<div class="url-readout">
				<div class="url-readout-head">
					<span class="svc-key">{ urlEnvKey }</span>
					<button class="btn btn-ghost btn-sm readout-copy js-copy" type="button" data-copy="svc-conn-url">Copy</button>
				</div>
				<code class="url-readout-value" id="svc-conn-url">{ connURL }</code>
				<p class="panel-hint">Injected automatically for apps in this project's { sv.Environment } environment. Copy it into an env var only when an app expects a different key — the password is generated once, encrypted at rest, and shown nowhere else.</p>
			</div>
		}

		<div class="panel">
			<div class="panel-title">Used by</div>
			if len(users) == 0 {
				<p class="muted-text">No app in this project's { sv.Environment } environment yet. Apps there get this service's connection URL as { urlEnvKey } the next time they deploy.</p>
			} else {
				<div class="rows rows-flush">
					for _, a := range users {
						<a class="app-row app-row-compact" href={ templ.SafeURL("/apps/" + a.Slug) }>
							<span class={ "lamp", "lamp-" + lampState(a) } aria-hidden="true"></span>
							<span class="row-main"><span class="row-name">{ a.Name }</span><span class="row-sub">{ statusText(a) }</span></span>
							<span class="muted-text">gets { urlEnvKey }</span>
						</a>
					}
				</div>
			}
		</div>

		if sv.Type == "postgres" {
			@backupPanel(vc, sv, bk)
		}

		<div class="panel panel-warn">
			<div class="panel-title">Delete this service</div>
			<p class="muted-text">Removes the container and this entry. The data volume is kept, so the data survives, but apps lose their connection URL.</p>
			<form method="post" action={ "/services/" + sv.Slug + "/delete" } onsubmit="return confirm('Delete this service? Its data volume will be kept.')" class="danger-form">
				<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
				<button class="btn btn-danger" type="submit">Delete service</button>
			</form>
		</div>
	}
}

// backupPanel is the opt-in config + catalog for database backups
// (docs/specs/database-backups.md). Postgres-only in the MVP — the
// template gate above hides it for MySQL/Redis.
templ backupPanel(vc ViewCtx, sv store.Service, bk BackupView) {
	<div class="panel">
		<div class="panel-title">Backups</div>
		// The settings always render — a server-side prerequisite is no
		// reason for the page to look empty. With no destination configured
		// on the host they show disabled and say why.
		if !bk.HasDests {
			if bk.Enabled {
				<p class="bk-note warn-note">Backups are paused: this service's destination is no longer configured on the server. Restoring from existing snapshots still works.</p>
			} else {
				<p class="bk-note">No backup destination is configured on this server — add a DEPLOYMATE_BACKUP_DEST_&lt;ID&gt;_* block on the host and restart to unlock these settings.</p>
			}
		}
		<form class="bk-form" method="post" action={ "/services/" + sv.Slug + "/backup" }>
			<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
			<div class="switch-row">
				<input class="switch" type="checkbox" name="enabled" id="bk-enabled" if bk.Enabled { checked } if !bk.HasDests { disabled }/>
				<label class="switch-label" for="bk-enabled">Enable backups</label>
			</div>

			<div class="bk-config">
				<div class="form-grid">
					<label>
						<span class="field-label">Schedule (server-local cron)</span>
						<input type="text" name="schedule" list="cron-presets" value={ bk.Schedule } required if !bk.HasDests { disabled }/>
						<datalist id="cron-presets">
							<option value="0 2 * * *">Daily 02:00</option>
							<option value="0 0 * * *">Daily midnight</option>
							<option value="13 * * * *">Hourly at :13</option>
							<option value="0 3 * * 0">Weekly Sun 03:00</option>
						</datalist>
					</label>
					<label>
						<span class="field-label">Keep newest</span>
						<input type="number" name="keep" min="1" max="366" value={ bk.Keep } required if !bk.HasDests { disabled }/>
					</label>
					<label>
						<span class="field-label">Destination</span>
						<select name="destination" if !bk.HasDests { disabled }>
							for _, id := range bk.DestIDs {
								<option value={ id } if bk.Destination == id { selected }>{ id }</option>
							}
						</select>
					</label>
				</div>
				<button class="btn btn-primary" type="submit" if !bk.HasDests { disabled }>Save settings</button>
			</div>

			<div class="bk-off">
				<p>Nothing leaves this machine while backups are off.</p>
				<button class="btn btn-ghost" type="submit" if !bk.HasDests { disabled }>Save settings</button>
			</div>
		</form>

		if bk.Enabled {
			<div class="bk-actions">
				<form method="post" action={ "/services/" + sv.Slug + "/backup/now" }>
					<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
					<button class="btn btn-ghost" type="submit">Back up now</button>
				</form>
				<a class="btn btn-ghost" href={ "/services/" + sv.Slug + "/backup/key" }>Download backup key</a>
			</div>
			<p class="bk-note">The backup key encrypts every snapshot of this database. Download it once and keep a copy off-box — a snapshot made by a dead server is deliberately unreadable without it.</p>
		}

		@backupCatalog(vc, sv, bk)
	</div>
}

// backupCatalog lists the destination's objects for this service. Rendering
// is independent of the on/off state: a disabled service keeps its
// snapshots listable and restorable.
templ backupCatalog(vc ViewCtx, sv store.Service, bk BackupView) {
	<div class="panel-sub">Stored backups</div>
	if len(bk.Objects) == 0 {
		<p class="muted">No snapshots yet
			if bk.Enabled {
				— the first lands on the schedule, or hit Back up now.
			} else {
				.
			}
		</p>
	} else {
		<div class="table-wrap">
			<table class="deploy-table">
				<thead>
					<tr>
						<th>Taken</th>
						<th>Size</th>
						<th>Sha256</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, o := range bk.Objects {
						<tr>
							<td class="mono">{ shortTime(o.TakenAt) }</td>
							<td>{ fmtBytes(uint64(o.Size)) }</td>
							<td class="mono">
								if len(o.SHA) >= 12 {
									{ o.SHA[:12] + "…" }
								} else {
									<span class="muted">—</span>
								}
							</td>
							<td>
								<form method="post" action={ "/services/" + sv.Slug + "/backups/restore" } onsubmit="return confirmRestore(this)">
									<input type="hidden" name="csrf_token" value={ vc.CSRF }/>
									<input type="hidden" name="object_key" value={ o.Key }/>
									<button class="btn btn-danger btn-sm" type="submit">Restore</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="bk-note">Restoring drops and recreates the database from the snapshot — apps keep running and reconnect. Restore to a same-version Postgres: a dump from an older major usually restores, one into a <em>newer</em> major may fail.</p>
	}
}
